# PriceScope backend environment variables (template only).
# Set real values in your local environment or deployment dashboard.

# Required by the backend. Replace this local placeholder for local development.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pricescope_dev

# Writable local development requires both settings explicitly.
APP_ENV=development
PUBLIC_READ_ONLY=false

# Render/production must remain read-only. PUBLIC_READ_ONLY=false never
# enables writes when APP_ENV=production.
# APP_ENV=production
# PUBLIC_READ_ONLY=true

# JSON array parsed by Pydantic Settings. Empty by default so localhost is not
# accidentally enabled in production.
CORS_ORIGINS=[]

# For local development, set for example:
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# In Render, set the exact deployed Vercel origin(s) instead.
